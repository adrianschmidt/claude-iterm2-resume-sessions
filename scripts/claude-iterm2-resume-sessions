#!/usr/bin/env python3
"""Reopen the Claude Code sessions that were running when the machine went down.

Reads ~/.claude/resume-registry (maintained by the session-registry.py hook)
and runs `claude --resume <id>` for each session in the iTerm2 pane it was
running in, or in a tab of a new window when that pane is gone.

Commands:
  resume [--dry-run]   resume every resumable session (default)
  list                 show registry records and why each would/wouldn't resume
  import-live          seed the registry from currently running sessions, for
                       sessions started before the hook was installed
  prune                delete records for sessions that will never resume
"""
import glob
import json
import os
import shlex
import subprocess
import sys
import time

REGISTRY_DIR = os.path.expanduser("~/.claude/resume-registry")
LIVE_DIR = os.path.expanduser("~/.claude/sessions")
MAX_AGE_DAYS = 30


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
    os.replace(tmp, path)


def live_session_ids():
    ids = set()
    for path in glob.glob(os.path.join(LIVE_DIR, "*.json")):
        data = load_json(path) or {}
        if data.get("sessionId"):
            ids.add(data["sessionId"])
    return ids


def title_from_transcript(transcript_path):
    """The name set via /rename is only persisted as custom-title lines in the
    transcript; the last one wins."""
    title = None
    try:
        with open(transcript_path, "rb") as f:
            for line in f:
                if b'"custom-title"' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if entry.get("type") == "custom-title":
                    title = entry.get("customTitle") or title
    except OSError:
        pass
    return title


def records():
    out = []
    for path in sorted(glob.glob(os.path.join(REGISTRY_DIR, "*.json"))):
        data = load_json(path)
        if data and data.get("session_id"):
            data["_path"] = path
            out.append(data)
    return out


def skip_reason(rec, live):
    if rec.get("entrypoint") not in (None, "cli"):
        return "not an interactive terminal session"
    if rec["session_id"] in live:
        return "already running"
    if rec.get("end_reason") and rec["end_reason"] != "other":
        return "ended deliberately (%s)" % rec["end_reason"]
    transcript = rec.get("transcript_path")
    if transcript and not os.path.exists(transcript):
        return "transcript gone"
    if rec.get("cwd") and not os.path.isdir(rec["cwd"]):
        return "directory gone: %s" % rec["cwd"]
    age_days = (time.time() - rec.get("updated_at", 0)) / 86400
    if age_days > MAX_AGE_DAYS:
        return "last seen %d days ago" % age_days
    return None


def display_title(rec):
    return (
        title_from_transcript(rec.get("transcript_path") or "")
        or rec.get("title")
        or rec["session_id"][:8]
    )


def applescript_string(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def osascript(lines):
    return subprocess.run(
        ["osascript", "-e", "\n".join(lines)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout


def iterm_installed():
    return any(
        os.path.isdir(os.path.expanduser(p))
        for p in ("/Applications/iTerm.app", "~/Applications/iTerm.app")
    )


def wait_for_iterm(timeout=120):
    """Wait until iTerm2 has restored its windows, launching it if needed, so
    the original panes exist and their shells have reached the prompt."""
    deadline = time.time() + timeout
    launched = False
    while time.time() < deadline:
        procs = subprocess.run(
            ["ps", "-axo", "comm="], capture_output=True, text=True
        ).stdout.splitlines()
        if any(p.endswith("/MacOS/iTerm2") for p in procs):
            count = osascript(['tell application "iTerm2" to count windows']).strip()
            if count.isdigit() and int(count) > 0:
                time.sleep(5)
                return True
        elif not launched:
            subprocess.run(["open", "-a", "iTerm"])
            launched = True
        time.sleep(2)
    return False


def idle_iterm_sessions():
    """Ids of restored panes sitting at a shell prompt, i.e. safe to type into."""
    out = osascript(
        [
            'tell application "iTerm2"',
            'set found to ""',
            "repeat with w in windows",
            "repeat with t in tabs of w",
            "repeat with s in sessions of t",
            "if is at shell prompt of s then set found to found & (id of s) & linefeed",
            "end repeat",
            "end repeat",
            "end repeat",
            "return found",
            "end tell",
        ]
    )
    return set(out.split())


def write_to_iterm_session(session_id, command):
    osascript(
        [
            'tell application "iTerm2"',
            "repeat with w in windows",
            "repeat with t in tabs of w",
            "repeat with s in sessions of t",
            "if id of s is %s then" % applescript_string(session_id),
            "tell s to write text %s" % applescript_string(command),
            "return",
            "end if",
            "end repeat",
            "end repeat",
            "end repeat",
            "end tell",
        ]
    )


def open_in_new_iterm_window(commands):
    lines = ['tell application "iTerm2"', "activate"]
    for i, command in enumerate(commands):
        if i == 0:
            lines.append("set w to (create window with default profile)")
        else:
            lines.append("tell w to create tab with default profile")
        lines.append(
            "tell current session of w to write text %s"
            % applescript_string(command)
        )
    lines.append("end tell")
    osascript(lines)


def cmd_list():
    live = live_session_ids()
    for rec in records():
        reason = skip_reason(rec, live)
        status = "SKIP  " + reason if reason else "RESUME"
        print("%s  %-30s %s  %s" % (rec["session_id"][:8], display_title(rec)[:30], status, rec.get("cwd", "")))


def cmd_resume(dry_run):
    live = live_session_ids()
    plan = []
    for rec in records():
        if skip_reason(rec, live):
            continue
        command = "cd %s && claude --resume %s" % (
            shlex.quote(rec["cwd"]),
            shlex.quote(rec["session_id"]),
        )
        plan.append((rec, command))
    if not plan:
        print("nothing to resume")
        return
    if not iterm_installed():
        sys.exit("iTerm2 is not installed; this tool only knows how to drive iTerm2")
    if not dry_run:
        wait_for_iterm()
    idle_panes = idle_iterm_sessions()
    fallback = []
    for rec, command in plan:
        pane = rec.get("iterm_session_id")
        title = display_title(rec)
        if pane in idle_panes:
            print("%s  -> original pane %s" % (title, pane))
            if not dry_run:
                write_to_iterm_session(pane, command)
        else:
            why = "pane gone or busy" if pane else "no pane recorded"
            print("%s  -> new tab (%s)" % (title, why))
            fallback.append(command)
    if fallback and not dry_run:
        open_in_new_iterm_window(fallback)


def iterm_pane_of_pid(pid):
    try:
        env = subprocess.run(
            ["ps", "eww", "-o", "command=", "-p", str(pid)],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    except subprocess.CalledProcessError:
        return None
    for token in env.split():
        if token.startswith("ITERM_SESSION_ID="):
            return token.split("=", 1)[1].split(":")[-1]
    return None


def cmd_import_live():
    os.makedirs(REGISTRY_DIR, exist_ok=True)
    now = int(time.time())
    for path in glob.glob(os.path.join(LIVE_DIR, "*.json")):
        data = load_json(path) or {}
        if data.get("kind") != "interactive" or not data.get("sessionId"):
            continue
        target = os.path.join(REGISTRY_DIR, data["sessionId"] + ".json")
        rec = load_json(target) or {"started_at": now}
        pane = iterm_pane_of_pid(data.get("pid"))
        rec.update(
            {
                "session_id": data["sessionId"],
                "cwd": data.get("cwd"),
                "title": data.get("name") if data.get("nameSource") == "user" else rec.get("title"),
                "entrypoint": data.get("entrypoint", "cli"),
                "iterm_session_id": pane or rec.get("iterm_session_id"),
                "updated_at": now,
                "ended_at": None,
                "end_reason": None,
            }
        )
        write_json(target, rec)
        print("imported %s  %s  pane=%s" % (data["sessionId"][:8], data.get("name"), pane))


def cmd_prune():
    live = live_session_ids()
    for rec in records():
        reason = skip_reason(rec, live)
        if reason and reason != "already running":
            os.remove(rec["_path"])
            print("pruned %s  %s" % (rec["session_id"][:8], reason))


def main(argv):
    cmd = argv[0] if argv else "resume"
    if cmd == "resume":
        cmd_resume(dry_run="--dry-run" in argv)
    elif cmd == "list":
        cmd_list()
    elif cmd == "import-live":
        cmd_import_live()
    elif cmd == "prune":
        cmd_prune()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
